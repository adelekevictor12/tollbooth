# ── Tollbooth environment ─────────────────────────────────────────────
# Copy to app/.env (and mcp/.env, agent/.env as noted) and fill in.
# With NO keys set, Tollbooth runs fully in mock mode: PayPal orders are
# simulated locally and the whole demo works end-to-end.

# Public base URL of the Tollbooth app (used for approve links, gateway callbacks)
APP_URL=http://localhost:3000

# ── PayPal (https://developer.paypal.com → Apps & Credentials) ──
# Leave PAYPAL_CLIENT_ID empty to run in mock mode.
# PAYPAL_MODE picks the PayPal environment when credentials are set:
#   sandbox (default) | live (production — api-m.paypal.com, your LIVE app
#   credentials + its own webhook subscription) | mock
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=             # Webhook subscription ID (for signature verification)
# Sandbox business account email that receives agent payments (payee routing
# for agent-card checkout — required when PAYPAL_MODE=sandbox).
PAYPAL_PAYEE_EMAIL=

# ── Live (production) agent-card checkout — optional, off by default ──
# Unattended card capture against the live API is PayPal "advanced card
# processing": enable only if your account has that approval. Requires
# PAYPAL_LIVE_AGENT_CARD=true AND real card details below (the sandbox test
# card is never sent to the live API; without these, live uses the wallet
# flow where the payer approves via PayPal).
PAYPAL_LIVE_AGENT_CARD=
PAYPAL_AGENT_CARD_NAME=
PAYPAL_AGENT_CARD_NUMBER=
PAYPAL_AGENT_CARD_EXPIRY=      # e.g. 2030-12
PAYPAL_AGENT_CARD_CVV=

# ── APIMatic (https://www.apimatic.io → Account Settings → API Keys) ──
# Unlocks live spec transformation + multi-language SDK generation.
# Leave empty to run in local-generation mode (context files still generated).
APIMATIC_API_KEY=
APIMATIC_BASE_URL=             # optional override (default https://api.apimatic.io)

# ── Buyer agent (agent/ workspace): Gemini OR Claude — either works ──
# Gemini (free key): aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Claude (optional): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Platform take-rate on API usage, in percent
PLATFORM_FEE_PCT=10
